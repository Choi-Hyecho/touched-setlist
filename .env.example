# Supabase 설정
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 어드민 계정 (초기 설정용)
ADMIN_EMAIL=admin@touched.com
ADMIN_PASSWORD=your_secure_password_here

# 배포 환경
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# 트위터(X) 자동 게시 - developer.twitter.com에서 발급 (OAuth 1.0a, Read and Write 권한)
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# 트위터 예약 발행 - Netlify Scheduled Function이 /api/admin/tweet/run-due 호출 시 사용하는 비밀키
# 배포 시 Netlify 사이트 환경변수에도 동일한 값을 등록해야 함
CRON_SECRET=your_random_secret_here
